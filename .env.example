# ---------------------------------------------------------------------------
# Front-end build-time variables (Vite). Copy to `.env` and fill in.
# Anything prefixed with VITE_ is embedded in the public JS bundle — never put
# secrets here. Supabase's publishable/anon key is designed to be public, but
# it is only safe because the RLS policies in supabase/migrations are strict.
# ---------------------------------------------------------------------------

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Canonical origin used for canonicals, og:url, JSON-LD @ids and the generated
# sitemap/robots files. Leave unset to use the default production domain.
VITE_SITE_URL="https://newssparkle.lovable.app"

# Local UI development against sample fixtures instead of the database.
# Never enable this in a deployed build. See src/lib/demo/.
VITE_DEMO_MODE="false"

# ---------------------------------------------------------------------------
# Edge function secrets (server side only — set with `supabase secrets set`):
#
#   AUTO_PUBLISH_SECRET   shared secret for the automation endpoints.
#                         Must match the value stored in Supabase Vault under
#                         the name `auto_publish_secret` (see migration
#                         20261016090100_phase6_autonomy_crons.sql). The cron
#                         wrapper also reads `newsroom_base_url` from Vault
#                         (defaults to the project URL).
#   LOVABLE_API_KEY       AI gateway key used to write articles (required)
#                         Phase 6 also accepts OPENAI_API_KEY / AI_API_KEY.
#   AI_BASE_URL           OpenAI-compatible endpoint (default api.openai.com/v1)
#   AI_MODEL              writer model (default gpt-4o-mini)
#   SITE_URL              canonical origin used inside feeds/sitemaps and by the
#                         maintenance sweep (NEWSROOM_BASE_URL also accepted)
#   CRON_SECRET           legacy alias for AUTO_PUBLISH_SECRET, still accepted by
#                         the older endpoints (set it to the same value)
#   AUTO_PUBLISH_URL      override the orchestrator URL breaking-news-monitor
#                         calls (defaults to <project>/functions/v1/auto-publish)
#   GNEWS_API_KEY         legacy adapter keys. The Phase 6 pipeline reads its
#   NEWSAPI_KEY           sources from the `content_sources` table instead, so
#   SERPAPI_KEY           nothing reads these today — set them only if you add
#                         an adapter back.
#   UNSPLASH_ACCESS_KEY   optional — topic-relevant featured images
#   PEXELS_API_KEY        optional — fallback featured images (picsum is the
#                         deterministic last resort if neither is configured)
#
# Example:
#   supabase secrets set AUTO_PUBLISH_SECRET=$(openssl rand -hex 32)
#   supabase secrets set SITE_URL=https://newssparkle.lovable.app
#   supabase secrets set LOVABLE_API_KEY=...
#   supabase functions deploy
# ---------------------------------------------------------------------------
